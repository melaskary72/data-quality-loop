# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=

# Model used for every LLM stage. Read from env so no model id is hardcoded.
DQL_MODEL=claude-haiku-4-5

# Hard ceiling on cumulative API spend, in USD. The runner aborts before a call
# that would cross this line.
DQL_COST_CAP_USD=3.00

# Optional: summary email from `python -m dql report --email`.
RESEND_API_KEY=
DQL_EMAIL_TO=
