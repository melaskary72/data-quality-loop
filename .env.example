# Copy to .env and fill in. .env is gitignored and must never be committed.
ANTHROPIC_API_KEY=

# Bulk labeling model: 60 batches of routine classification. Cheapest capable.
DQL_MODEL=claude-haiku-4-5

# Taxonomy induction model. Seven calls that set the vocabulary every later
# stage is bound to, including repairing a proposal against validator output.
# Left unset it defaults to a stronger model than DQL_MODEL on purpose.
DQL_INDUCE_MODEL=claude-sonnet-5

# Hard ceiling on cumulative API spend, in USD. The runner aborts before a call
# that would cross this line.
DQL_COST_CAP_USD=3.00

# Optional: summary email from `python -m dql report --email`.
RESEND_API_KEY=
DQL_EMAIL_TO=
